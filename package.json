{
  "name": "paged-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "description": "docs.paged.media — the independent IDML living reference (Fumadocs).",
  "scripts": {
    "dev": "pnpm generate:docs && next dev",
    "prepare:preview": "node scripts/prepare-preview-wasm.mjs",
    "generate:docs": "node scripts/generate/pull-sources.mjs && node scripts/generate/gen-matrix.mjs && node scripts/generate/gen-scripting.mjs && node scripts/generate/gen-cli.mjs && node scripts/generate/gen-surfaces.mjs && node scripts/generate/gen-plugin-sdk.mjs && node scripts/generate/gen-api.mjs && node scripts/generate/gen-activity.mjs && node scripts/generate/gen-sdk.mjs && node scripts/generate/gen-idml-schema.mjs && node scripts/generate/gen-crosslinks.mjs",
    "build": "pnpm generate:docs && pnpm prepare:preview && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "examples:assemble": "tsx scripts/examples/assemble-cli.ts",
    "examples:index": "tsx scripts/examples/index.ts",
    "validate:examples": "tsx scripts/examples/validate.ts",
    "check:scripting": "tsx scripts/scripting/check-corpus.ts",
    "validate:scripting": "tsx scripts/scripting/validate.ts",
    "check:feature-refs": "node scripts/check-feature-refs.mjs",
    "check:freshness": "node scripts/check-freshness.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "update:comparison": "node scripts/update-comparison.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@paged-media/demo-replay": "github:paged-media/demo-replay#685b976af0bbe70a50476ccb2aa12f907b91c7c4",
    "@paged-media/idml-viewer": "0.63.0",
    "fflate": "^0.8.3",
    "fumadocs-core": "^16.15.8",
    "fumadocs-ui": "^16.15.8",
    "monaco-editor": "0.55.1",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrweb": "^2.1.4",
    "shiki": "^1.29.2",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-mdx": "^15.4.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
