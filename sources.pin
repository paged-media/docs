{
  "$comment": "Pinned cross-repo sources for the docs generation pipeline (scripts/generate/pull-sources.mjs). The docs are generated FROM these machine-readable sources so they never go stale by hand. `ref` is the git ref to pull from (default `main` = always-fresh); set an explicit commit SHA to freeze a source for a reproducible build. pull-sources records the RESOLVED sha of each source in .generated/sources.lock.json for provenance. Local runs prefer the sibling working copy `../<repo>` next to this checkout when present (pass --remote to force GitHub). Since 2026-10-18 the product code lives in the monorepo paged-media/paged (sibling `../paged`); every product source names repo `paged` and a path inside it. The earlier per-component repositories are archived. Bump policy: this file + the nightly re-pull + on-push dispatch are the freshness controls. Same spirit as core.pin.",
  "org": "paged-media",
  "sources": {
    "cockpit": {
      "$comment": "The capability record (cockpit.export.v1): every feature with its lifecycle, claims per component and the health its CI test evidence gives it. Produced by cockpit's export workflow (nightly and on each repo's main test run) and committed to exports/public.json; `remote` because only CI writes it. Replaces the retired state registry (2026-10-12).",
      "repo": "cockpit",
      "ref": "main",
      "remote": true,
      "files": {
        "public.json": "exports/public.json"
      }
    },
    "capability-matrix": {
      "$comment": "The capability x surface matrix: every wire op and wire kind against the seven programmable surfaces, each cell derived from the gate that owns that surface (core's cli_surface.rs and script_surface.rs, the editor's probed capability table, the client's generated catalog). Produced by cockpit's export workflow from current mains; was state's frozen protocol-63 copy until 2026-10-12.",
      "repo": "cockpit",
      "ref": "main",
      "remote": true,
      "files": {
        "capability-matrix.json": "exports/capability-matrix.json"
      }
    },
    "core-catalog": {
      "repo": "paged",
      "ref": "core.pin",
      "files": {
        "catalog.json": "engine/core/crates/paged-introspect/catalog.json"
      }
    },
    "sdk-catalog": {
      "repo": "paged",
      "ref": "core.pin",
      "files": {
        "api.json": "engine/core/web/idml-viewer/api-catalog.json"
      }
    },
    "cli-surface": {
      "$comment": "The `paged` command tree, walked out of clap itself by `cargo run -p paged-cli --example emit-cli-surface`. Added 2026-09-09: docs.paged.media had no CLI page at all, and writing one by hand would have made a second statement of the tree that drifts the first time a flag is added.",
      "repo": "paged",
      "ref": "core.pin",
      "files": {
        "cli.json": "engine/core/crates/paged-cli/cli.json"
      }
    },
    "plugin-sdk": {
      "repo": "paged",
      "ref": "main",
      "files": {
        "manifest.schema.json": "platform/extensions/packages/plugin-api/src/manifest.schema.json"
      }
    },
    "idml-coverage": {
      "$comment": "Which IDML (element, attribute) pairs Paged's importer reads and its exporter writes, extracted from the IDML adapter source (engine/core/crates/idml-import and idml-export) by idml-coverage (gated by idml_coverage_json_is_current). Feeds the element reference (ADR 805 / gen-idml-reference). Read from the monorepo's main like the other always-fresh sources; it was frozen at the archived plugin-publish repository's copy until the adapter moved into the engine.",
      "repo": "paged",
      "ref": "main",
      "files": {
        "idml-coverage.json": "engine/core/docs/reference/idml-coverage.json"
      }
    },
    "editor-catalog": {
      "$comment": "The editor's programmable client surface (@paged-media/client): its members and the wire kinds they reach. One column of the surface table.",
      "repo": "paged",
      "ref": "main",
      "files": {
        "api-catalog.json": "apps/editor/packages/client/api-catalog.json",
        "package.json": "apps/editor/package.json",
        "canvas-package.json": "apps/editor/apps/canvas/package.json"
      }
    },
    "plugin-sheets": {
      "repo": "paged",
      "ref": "main",
      "files": {
        "package.json": "modules/sheet/package.json"
      },
      "dirs": {
        "functions": "modules/sheet/registry/functions"
      }
    },
    "plugin-image": {
      "repo": "paged",
      "ref": "main",
      "files": {
        "package.json": "modules/image/package.json",
        "kernels.yaml": "modules/image/registry/kernels.yaml"
      }
    },
    "plugin-data": {
      "repo": "paged",
      "ref": "main",
      "files": {
        "package.json": "modules/data/package.json"
      },
      "dirs": {
        "functions": "modules/data/registry/functions"
      }
    },
    "core-meta": {
      "$comment": "The engine workspace's Cargo metadata at core.pin (its licence).",
      "repo": "paged",
      "ref": "core.pin",
      "files": {
        "Cargo.toml": "engine/core/Cargo.toml"
      }
    },
    "engine-main": {
      "$comment": "The engine workspace's Cargo metadata on the monorepo's main (its current licence; core-meta is the licence of the pinned release).",
      "repo": "paged",
      "ref": "main",
      "files": {
        "Cargo.toml": "engine/core/Cargo.toml"
      }
    },
    "server-meta": {
      "$comment": "paged.server's Cargo metadata on the monorepo's main (its licence).",
      "repo": "paged",
      "ref": "main",
      "files": {
        "Cargo.toml": "apps/server/server/Cargo.toml"
      }
    }
  },
  "activity": {
    "$comment": "Cross-repo recent-commit feed. Pulled at build time via `gh api` (token-authenticated; private repos included by user decision). perRepo = commits fetched per repo. `repos` are whole-repository feeds and make up the timeline; `components` are path-scoped feeds of a repository (the monorepo's components, keyed by the name a <RepoActivity repo=…> uses) and are not added to the timeline, which already carries the monorepo's commits.",
    "perRepo": 12,
    "repos": [
      "paged",
      "docs",
      "cockpit",
      "plugin-template",
      "website",
      "brand",
      "thoughts",
      "corpus"
    ],
    "components": {
      "core": {
        "repo": "paged",
        "path": "engine/core"
      },
      "viewer": {
        "repo": "paged",
        "path": "engine/core/web/idml-viewer"
      },
      "editor": {
        "repo": "paged",
        "path": "apps/editor"
      },
      "editor-server": {
        "repo": "paged",
        "path": "apps/server"
      },
      "plugin-sdk": {
        "repo": "paged",
        "path": "platform/extensions"
      },
      "plugin-publish": {
        "repo": "paged",
        "path": "modules/publish"
      },
      "plugin-draw": {
        "repo": "paged",
        "path": "modules/draw"
      },
      "plugin-web": {
        "repo": "paged",
        "path": "modules/web"
      },
      "plugin-image": {
        "repo": "paged",
        "path": "modules/image"
      },
      "plugin-sheets": {
        "repo": "paged",
        "path": "modules/sheet"
      },
      "plugin-data": {
        "repo": "paged",
        "path": "modules/data"
      },
      "plugin-doc": {
        "repo": "paged",
        "path": "modules/doc"
      },
      "plugin-slide": {
        "repo": "paged",
        "path": "modules/slide"
      }
    }
  }
}
