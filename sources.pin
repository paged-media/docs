{
  "$comment": "Pinned cross-repo sources for the docs generation pipeline (scripts/generate/pull-sources.mjs). The docs are generated FROM these machine-readable sources so they never go stale by hand. `ref` is the git ref to pull from (default `main` = always-fresh); set an explicit commit SHA to freeze a source for a reproducible build. pull-sources records the RESOLVED sha of each source in .generated/sources.lock.json for provenance. Local runs prefer the sibling working copy under ~/paged/<repo> when present (pass --remote to force GitHub). Bump policy: this file + the nightly re-pull + on-push dispatch are the freshness controls. Same spirit as core.pin.",
  "org": "paged-media",
  "sources": {
    "cockpit": {
      "$comment": "The capability record (cockpit.export.v1): every feature with its lifecycle, claims per component and the health its CI test evidence gives it. Produced by cockpit's export workflow (nightly and on each repo's main test run) and committed to exports/public.json; `remote` because only CI writes it. Replaces the retired state registry (2026-10-12).",
      "repo": "cockpit",
      "ref": "main",
      "remote": true,
      "files": {
        "public.json": "exports/public.json"
      }
    },
    "capability-matrix": {
      "$comment": "The capability x surface matrix: every wire op and wire kind against the seven programmable surfaces, each cell derived from the gate that owns that surface (core's cli_surface.rs and script_surface.rs, the editor's probed capability table, the client's generated catalog). Produced by cockpit's export workflow from current mains; was state's frozen protocol-63 copy until 2026-10-12.",
      "repo": "cockpit",
      "ref": "main",
      "remote": true,
      "files": {
        "capability-matrix.json": "exports/capability-matrix.json"
      }
    },
    "core-catalog": {
      "repo": "core",
      "ref": "core.pin",
      "files": {
        "catalog.json": "crates/paged-introspect/catalog.json"
      }
    },
    "sdk-catalog": {
      "repo": "core",
      "ref": "core.pin",
      "files": {
        "api.json": "web/idml-viewer/api-catalog.json"
      }
    },
    "cli-surface": {
      "$comment": "The `paged` command tree, walked out of clap itself by `cargo run -p paged-cli --example emit-cli-surface`. Added 2026-09-09: docs.paged.media had no CLI page at all, and writing one by hand would have made a second statement of the tree that drifts the first time a flag is added.",
      "repo": "core",
      "ref": "core.pin",
      "files": {
        "cli.json": "crates/paged-cli/cli.json"
      }
    },
    "plugin-sdk": {
      "repo": "plugin-sdk",
      "ref": "main",
      "files": {
        "manifest.schema.json": "packages/plugin-api/src/manifest.schema.json"
      }
    },
    "editor-server": {
      "repo": "editor-server",
      "ref": "main",
      "files": {
        "openapi.json": "generated/openapi.json"
      }
    },
    "idml-coverage": {
      "$comment": "Which IDML (element, attribute) pairs Paged's importer reads and its exporter writes, extracted from the plugin-publish source by tools/idml-coverage (gated by idml_coverage_json_is_current). Feeds the element reference (ADR 805 / gen-idml-reference). Pinned to a commit, bumped deliberately.",
      "repo": "plugin-publish",
      "ref": "74c6ccc",
      "files": {
        "idml-coverage.json": "docs/reference/idml-coverage.json"
      }
    },
    "editor-catalog": {
      "$comment": "The editor's programmable client surface (@paged-media/client): its members and the wire kinds they reach. One column of the surface table.",
      "repo": "editor",
      "ref": "main",
      "files": {
        "api-catalog.json": "packages/client/api-catalog.json",
        "package.json": "package.json"
      }
    },
    "plugin-sheets": {
      "repo": "plugin-sheets",
      "ref": "main",
      "files": {
        "package.json": "package.json"
      },
      "dirs": {
        "functions": "registry/functions"
      }
    },
    "plugin-image": {
      "repo": "plugin-image",
      "ref": "main",
      "files": {
        "package.json": "package.json",
        "kernels.yaml": "registry/kernels.yaml"
      }
    },
    "plugin-data": {
      "repo": "plugin-data",
      "ref": "main",
      "files": {
        "package.json": "package.json"
      },
      "dirs": {
        "functions": "registry/functions"
      }
    },
    "core-meta": {
      "$comment": "The engine workspace's Cargo metadata at core.pin (its licence).",
      "repo": "core",
      "ref": "core.pin",
      "files": {
        "Cargo.toml": "Cargo.toml"
      }
    }
  },
  "activity": {
    "$comment": "Cross-repo recent-commit feed. Pulled at build time via `gh api` (token-authenticated; private repos included by user decision). perRepo = commits fetched per repo.",
    "perRepo": 12,
    "repos": [
      "core",
      "editor",
      "editor-server",
      "docs",
      "cockpit",
      "plugin-sdk",
      "plugin-draw",
      "plugin-web",
      "plugin-image",
      "plugin-sheets",
      "plugin-data",
      "plugin-template",
      "viewer",
      "website",
      "brand",
      "thoughts",
      "corpus",
      "plugin-doc",
      "plugin-slide",
      "plugin-publish"
    ]
  }
}
