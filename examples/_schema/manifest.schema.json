{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.paged.media/schema/example.json",
  "title": "Paged docs example manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "tier",
    "chapter",
    "packageDir",
    "editable",
    "views"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Stable slug; MUST equal the example directory name."
    },
    "title": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "beginner",
        "intermediate",
        "pro"
      ]
    },
    "chapter": {
      "type": "string",
      "description": "The IA section slug this example anchors (e.g. package-anatomy)."
    },
    "concept": {
      "type": "string"
    },
    "packageDir": {
      "type": "string",
      "description": "Directory (relative to the example dir) holding the unzipped IDML parts."
    },
    "editable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part",
        "language",
        "label"
      ],
      "properties": {
        "part": {
          "type": "string",
          "description": "Path WITHIN packageDir of the chapter-relevant fragment the reader sees/edits."
        },
        "language": {
          "type": "string",
          "default": "xml"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "raw",
          "annotated",
          "tree",
          "live"
        ]
      },
      "uniqueItems": true
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lines",
          "note"
        ],
        "properties": {
          "lines": {
            "type": "string",
            "description": "A line number or \"start-end\" range."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "description": "The CI contract: what the renderer must report for the assembled package.",
      "properties": {
        "opens": {
          "type": "boolean"
        },
        "builds": {
          "type": "boolean"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "stories": {
          "type": "integer",
          "minimum": 0
        },
        "frames": {
          "type": "integer",
          "minimum": 0
        },
        "paragraphs": {
          "type": "integer",
          "minimum": 0
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pathological": {
      "type": "boolean",
      "default": false,
      "description": "true => the example is EXPECTED to surface a diagnostic, not crash."
    },
    "license": {
      "type": "string",
      "default": "MIT"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9:]*$"
      },
      "uniqueItems": true,
      "description": "IDML element names this example shows; the element reference lists the example on each one's page."
    },
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "description": "InDesign verification, written by scripts/examples/verify-indesign.sh. A stamp is shown only while partsHash matches the package.",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "not-applicable"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Why the example cannot be verified (status not-applicable)."
        },
        "indesignVersion": {
          "type": "string"
        },
        "verifiedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "partsHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "roundTrip": {
          "type": "boolean",
          "description": "InDesign re-saved the opened file as IDML without error."
        },
        "fidelity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "meanDE": {
              "type": "number"
            },
            "p99DE": {
              "type": "number"
            },
            "ssim": {
              "type": "number"
            },
            "fontsMatched": {
              "type": "boolean",
              "description": "InDesign set the text in the same face the browser preview has (Open Sans)."
            }
          }
        }
      }
    }
  }
}
